# ==========================================================
# RAKSHAK-GEO // CITYSHIELD GIS Environment Configuration
# ==========================================================
# Application Environment: 'development' or 'production'
ENVIRONMENT=development
DEMO_MODE=true

# Server Security & CORS Configuration
# Comma-separated list of allowed frontend origins (no trailing slashes)
# In production, specify your exact deployed frontend domain(s)
# e.g.: ALLOWED_ORIGINS=https://rakshak-geo.example.gov.in,https://command.rakshak-geo.gov.in
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:3000

# Rate Limiting & Resource Protection
MAX_REQUEST_SIZE_BYTES=10485760
RATE_LIMIT_PER_MINUTE=120

# Optional Administrative Secret Key (for future admin write operations)
# Generate a high-entropy string (e.g. via `openssl rand -hex 32`)
ADMIN_API_KEY=

# ==========================================================
# PostgreSQL / PostGIS Spatial Database Configuration
# ==========================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_secure_password_in_production
POSTGRES_DB=cityshield_gis
POSTGIS_ENABLED=false

# ==========================================================
# ISRO / NRSC Bhuvan Earth-Observation Geospatial Service
# ==========================================================
# Official Portal: https://bhuvan.nrsc.gov.in
# Obtain application access / token from Bhuvan Developer Portal / Bhoonidhi
# NOTE: Never commit your actual ISRO_API_KEY to source control or client code.
# The backend FastAPI proxy handles this securely without exposing it to browsers.
ISRO_API_KEY=your_isro_bhuvan_api_token_here
ISRO_BHUVAN_WMS_URL=https://bhuvan-vec1.nrsc.gov.in/bhuvan/gwc/service/wms
ISRO_BHUVAN_LAYER=india3

# ==========================================================
# Frontend Configuration (Astro / Client-Side)
# ==========================================================
# In production with a reverse proxy, leave blank for relative API requests.
# If frontend and backend are hosted on separate domains, specify full HTTPS URL:
# PUBLIC_API_URL=https://api.rakshak-geo.example.gov.in
PUBLIC_API_URL=
